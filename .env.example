# Copie para .env.local. NUNCA suba o .env.local para o GitHub.

# Supabase (pode ser o MESMO projeto do Lucrota). Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role: SECRETA, só no servidor (Vercel e .env.local)
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Avisos de pedido novo no celular da loja. Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:lucrota@gmail.com

# Pix pelo app (Mercado Pago, credencial de produção da sua conta)
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
